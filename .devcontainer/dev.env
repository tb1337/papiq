# Development settings for the `dev` container. Fixed credentials for local services only:
# never use these values anywhere else.
PAPIQ_LOG_FORMAT=console
PAPIQ_LOG_LEVEL=DEBUG

PAPIQ_DB_TYPE=postgres
PAPIQ_DB_HOST=postgres
PAPIQ_DB_PORT=5432
PAPIQ_DB_NAME=papiq
PAPIQ_DB_USER=papiq
PAPIQ_DB_PASSWORD=papiq

PAPIQ_STORAGE_TYPE=s3
PAPIQ_S3_ENDPOINT_URL=http://garage:3900
PAPIQ_S3_REGION=garage
PAPIQ_S3_BUCKET=papiq
PAPIQ_S3_ACCESS_KEY_ID=GKdeadbeefdeadbeefdeadbeef
PAPIQ_S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PAPIQ_S3_PATH_STYLE=true

PAPIQ_MEILISEARCH_URL=http://meilisearch:7700
PAPIQ_MEILISEARCH_API_KEY=dev-meilisearch-master-key

# No language model in the devcontainer. To use Ollama on the host, uncomment and adjust:
# PAPIQ_LLM_BASE_URL=http://host.docker.internal:11434/v1
# PAPIQ_LLM_MODEL=
# PAPIQ_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# PAPIQ_EMBEDDING_MODEL=
