# Settings of the development instance in the devcontainer: copy to live.env (not in the
# repository) or let the VS Code task "Papiq: Devinstanz einrichten" do it. The instance shares
# Postgres, Garage and Meilisearch with development and tests, but has its own database, bucket
# and index, so nothing deletes or overwrites its data. See .devcontainer/README.md.
PAPIQ_LOG_FORMAT=console
PAPIQ_LOG_LEVEL=INFO

# 32 random bytes, base64 (`openssl rand -base64 32`); the setup task fills it in. Keep it:
# TOTP and webhook secrets cannot be read without it.
PAPIQ_SECRET_KEY=
# The first admin, created at API start while there is none. Use the user name of the owner of
# your documents in Paperless, so that the migration maps them to you.
PAPIQ_ADMIN_USERNAME=
PAPIQ_ADMIN_PASSWORD=
# Plain HTTP inside the devcontainer.
PAPIQ_COOKIE_SECURE=false

PAPIQ_DB_TYPE=postgres
PAPIQ_DB_HOST=postgres
PAPIQ_DB_PORT=5432
PAPIQ_DB_NAME=papiq_live
PAPIQ_DB_USER=papiq
PAPIQ_DB_PASSWORD=papiq

PAPIQ_STORAGE_TYPE=s3
PAPIQ_S3_ENDPOINT_URL=http://garage:3900
PAPIQ_S3_REGION=garage
PAPIQ_S3_BUCKET=papiq-live
PAPIQ_S3_ACCESS_KEY_ID=GKdeadbeefdeadbeefdeadbeef
PAPIQ_S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PAPIQ_S3_PATH_STYLE=true

PAPIQ_MEILISEARCH_URL=http://meilisearch:7700
PAPIQ_MEILISEARCH_API_KEY=dev-meilisearch-master-key
PAPIQ_MEILISEARCH_INDEX=papiq-live-documents

# The built web UI, served below /ui (the task "Papiq: UI bauen" writes it).
PAPIQ_UI_DIR=../web/build

# Docling needs about 2 GB of RAM per job: 3 on 8 GB (backend/README.md, Worker).
PAPIQ_WORKER_CONCURRENCY=3

# Language model and embeddings on Ollama (OpenAI-compatible). On a CPU a document takes
# minutes; see the rules for mass runs in .devcontainer/README.md.
PAPIQ_LLM_BASE_URL=https://ollama.example.org/v1
PAPIQ_LLM_MODEL=qwen3:8b-ctx8k
PAPIQ_LLM_TIMEOUT=600
PAPIQ_EMBEDDING_BASE_URL=https://ollama.example.org/v1
PAPIQ_EMBEDDING_MODEL=snowflake-arctic-embed2
PAPIQ_EMBEDDING_QUERY_PREFIX=query:
PAPIQ_EMBEDDING_DIMENSIONS=1024

# Migration from Paperless-ngx (migration/README.md): the Paperless key only as a file outside
# the repository, the Papiq token of an admin with scope read_write from the UI (Settings).
PAPIQ_MIGRATION_PAPERLESS_URL=http://host.docker.internal:8765
PAPIQ_MIGRATION_PAPERLESS_TOKEN_FILE=/tmp/paperless-token
PAPIQ_MIGRATION_PAPIQ_URL=http://localhost:8000
PAPIQ_MIGRATION_PAPIQ_TOKEN_FILE=/tmp/papiq-token
